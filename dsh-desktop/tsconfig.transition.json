{
  // Task 3.5 编译收口：main 侧过渡代码（lib/desktop 14 模块、tauri-shell/sidecar、
  // 3 个根级过渡模块）沿用 Wave 0 约定 —— `import x = require()` 直译、就地
  // commonjs 产出；该语法与 erasableSyntaxOnly 互斥，故独立成本配置（继承其余
  // 全部严格度）。Task 6.5 删除 lib/desktop、Task 7.3 sidecar 改标准 import 后，
  // 本配置随之退役（届时并入 tsconfig.json）。
  //
  // 编译顺序约定（package.json build/typecheck）：transition 先、主配置后 ——
  // 过渡文件静态 import 的 refactor 模块（如 lib/plugin-copy.ts）会被两个程序
  // 各自就地 emit，主配置最后跑保证最终产物以严格基线为准。
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "erasableSyntaxOnly": false,
    "noEmit": false
  },
  "include": [
    "lib/desktop/**/*.ts",
    "../tauri-shell/sidecar/**/*.ts",
    "compact-preset-migrate.ts",
    "shortcut-maintenance.ts",
    "stream-write-guard.ts",
    "types-*.d.ts"
  ],
  "exclude": ["node_modules"]
}
